---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Alert } from "@/components/ui/alert";
import { LoginDialog } from "@/features/auth/presentation/LoginDialog";
import { createPublicationsApi } from "@/features/publications/infrastructure/publications.api";
import PublicationCard from "@/features/publications/presentation/PublicationCard.astro";
import { load, serverTransport } from "@/shared/api/server";

const { user, token } = Astro.locals;
const { data, error } = await load(() => createPublicationsApi(serverTransport(token)).list());
const news = (data ?? []).slice(0, 6);
---

<BaseLayout>
  <div class="landing-hero">
    <div class="landing-hero-content">
      <span class="landing-badge">Bienvenido</span>
      <h2>Hospital Oncológico de La Habana</h2>
      <p>
        Portal de información clínica para profesionales de la salud. Acceda a publicaciones, guías de
        diagnóstico, protocolos de tratamiento y documentación de referencia.
      </p>
      {!user && <LoginDialog client:load triggerLabel="Acceso para personal médico" triggerSize="lg" />}
    </div>
    <div class="landing-hero-stats">
      <div class="stat-card">
        <span class="stat-number">{news.length}</span>
        <span class="stat-label">Publicaciones</span>
      </div>
      <div class="stat-card">
        <span class="stat-number">24/7</span>
        <span class="stat-label">Recursos disponibles</span>
      </div>
    </div>
  </div>

  <div class="section-heading">
    <h3>Últimas publicaciones</h3>
    <p><a href="/publicaciones">Ver todas</a></p>
  </div>

  {error && <Alert>No se pudieron cargar las publicaciones: {error}</Alert>}
  <div class="card-grid">
    {
      news.map((item) => <PublicationCard item={item} />)
    }
    {!error && news.length === 0 && <p class="muted">Todavía no hay publicaciones.</p>}
  </div>
</BaseLayout>
