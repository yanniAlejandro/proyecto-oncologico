---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/site/PageHeader";
import { Alert } from "@/components/ui/alert";
import { createLinksApi } from "@/features/links/infrastructure/links.api";
import { load, serverTransport } from "@/shared/api/server";

const { data, error } = await load(() => createLinksApi(serverTransport(Astro.locals.token)).list());
const links = data ?? [];
---

<BaseLayout title="Enlaces de Interés">
  <PageHeader title="Enlaces de Interés" subtitle="Recursos externos de referencia para profesionales de la salud" />
  {error && <Alert>No se pudieron cargar los enlaces: {error}</Alert>}
  <div class="links-list">
    {
      links.map((link) => (
        <a href={link.url} target="_blank" rel="noreferrer" class="link-card">
          <h3>{link.title}</h3>
          {link.description && <p>{link.description}</p>}
          <span class="link-url">{link.url}</span>
        </a>
      ))
    }
    {!error && links.length === 0 && <p class="muted">No hay enlaces disponibles.</p>}
  </div>
</BaseLayout>
