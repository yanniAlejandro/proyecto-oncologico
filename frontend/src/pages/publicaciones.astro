---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/site/PageHeader";
import { Alert } from "@/components/ui/alert";
import { createPublicationsApi } from "@/features/publications/infrastructure/publications.api";
import PublicationCard from "@/features/publications/presentation/PublicationCard.astro";
import { load, serverTransport } from "@/shared/api/server";

const { data, error } = await load(() => createPublicationsApi(serverTransport(Astro.locals.token)).list());
const items = data ?? [];
---

<BaseLayout title="Publicaciones">
  <PageHeader title="Publicaciones" subtitle="Noticias y artículos compartidos por el hospital" />
  {error && <Alert>No se pudieron cargar las publicaciones: {error}</Alert>}
  <div class="card-grid">
    {items.map((item) => <PublicationCard item={item} />)}
    {!error && items.length === 0 && <p class="muted">Todavía no hay publicaciones.</p>}
  </div>
</BaseLayout>
