---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/site/PageHeader";
import { Alert } from "@/components/ui/alert";
import { createPublicationsApi } from "@/features/publications/infrastructure/publications.api";
import { PublicationsManager } from "@/features/publications/presentation/PublicationsManager";
import { load, serverTransport } from "@/shared/api/server";

// Acceso ya validado por el middleware (permiso «publicaciones»). Pasará al panel /admin en la fase 5.
const { data, error } = await load(() => createPublicationsApi(serverTransport(Astro.locals.token)).list());
---

<BaseLayout title="Gestión de Publicaciones">
  {
    error ? (
      <>
        <PageHeader title="Gestión de Publicaciones" />
        <Alert>{error}</Alert>
      </>
    ) : (
      <PublicationsManager client:load initialItems={data ?? []} />
    )
  }
</BaseLayout>
