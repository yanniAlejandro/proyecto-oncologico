---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/site/PageHeader";
import { Alert } from "@/components/ui/alert";
import { createUsersApi } from "@/features/users/infrastructure/users.api";
import { UsersManager } from "@/features/users/presentation/UsersManager";
import { load, serverTransport } from "@/shared/api/server";

// Acceso ya validado por el middleware (solo administrador).
const { data, error } = await load(() => createUsersApi(serverTransport(Astro.locals.token)).list());
---

<BaseLayout title="Gestión de Usuarios">
  {
    error ? (
      <>
        <PageHeader title="Gestión de Usuarios" />
        <Alert>{error}</Alert>
      </>
    ) : (
      <UsersManager client:load initialItems={data ?? []} />
    )
  }
</BaseLayout>
