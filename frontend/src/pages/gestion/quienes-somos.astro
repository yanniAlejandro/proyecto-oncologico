---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/site/PageHeader";
import { Alert } from "@/components/ui/alert";
import { createAboutApi } from "@/features/about/infrastructure/about.api";
import { AboutManager } from "@/features/about/presentation/AboutManager";
import { load, serverTransport } from "@/shared/api/server";

// Acceso validado por el middleware (permiso «quienes_somos»). Pasará al panel /admin en la fase 5.
const { data, error } = await load(() => createAboutApi(serverTransport(Astro.locals.token)).list());
---

<BaseLayout title="Gestión de Quiénes somos">
  {
    error ? (
      <>
        <PageHeader title="Gestión de «Quiénes somos»" />
        <Alert>{error}</Alert>
      </>
    ) : (
      <AboutManager client:load initialItems={data ?? []} />
    )
  }
</BaseLayout>
