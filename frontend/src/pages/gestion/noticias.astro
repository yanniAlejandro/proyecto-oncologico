---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/site/PageHeader";
import { Alert } from "@/components/ui/alert";
import { createNewsApi } from "@/features/news/infrastructure/news.api";
import { NewsManager } from "@/features/news/presentation/NewsManager";
import { load, serverTransport } from "@/shared/api/server";

// Acceso ya validado por el middleware (encargado o administrador).
const { data, error } = await load(() => createNewsApi(serverTransport(Astro.locals.token)).listAll());
---

<BaseLayout title="Gestión de Noticias">
  {
    error ? (
      <>
        <PageHeader title="Gestión de Noticias" />
        <Alert>{error}</Alert>
      </>
    ) : (
      <NewsManager client:load initialItems={data ?? []} />
    )
  }
</BaseLayout>
