---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/site/PageHeader";
import { Alert } from "@/components/ui/alert";
import { LoginDialog } from "@/features/auth/presentation/LoginDialog";
import { createClinicalApi } from "@/features/clinical/infrastructure/clinical.api";
import { ClinicalDocsPage } from "@/features/clinical/presentation/ClinicalDocsPage";
import { createDiseasesApi } from "@/features/diseases/infrastructure/diseases.api";
import { load, serverTransport } from "@/shared/api/server";
import { can, canReadClinical } from "@/shared/auth/roles";

const { user, token } = Astro.locals;
const canRead = canReadClinical(user);
const canManage = can(user, "protocolos");
const t = serverTransport(token);
const protocols = canRead ? await load(() => createClinicalApi(t, "protocol").list()) : null;
const diseases = canManage ? await load(() => createDiseasesApi(t).list()) : null;
---

<BaseLayout title="Protocolos de Tratamiento">
  {
    !user ? (
      <>
        <PageHeader title="Protocolos de Tratamiento" subtitle="Acceso restringido al personal autorizado" />
        <div class="access-notice">
          <p>Debes iniciar sesión como médico o administrador del Hospital Oncológico de La Habana.</p>
          <LoginDialog client:load triggerLabel="Iniciar sesión" />
        </div>
      </>
    ) : !canRead ? (
      <>
        <PageHeader title="Protocolos de Tratamiento" />
        <Alert>Tu rol no tiene permisos para ver los protocolos de tratamiento.</Alert>
      </>
    ) : protocols?.error ? (
      <>
        <PageHeader title="Protocolos de Tratamiento" />
        <Alert>Error al cargar los protocolos: {protocols.error}</Alert>
      </>
    ) : (
      <ClinicalDocsPage
        client:load
        kind="protocol"
        initialItems={protocols?.data ?? []}
        diseases={diseases?.data ?? []}
        canManage={canManage}
      />
    )
  }
</BaseLayout>
