---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { PageHeader } from "@/components/site/PageHeader";
import { Alert } from "@/components/ui/alert";
import { createClinicalApi } from "@/features/clinical/infrastructure/clinical.api";
import { ClinicalDocsPage } from "@/features/clinical/presentation/ClinicalDocsPage";
import { createDiseasesApi } from "@/features/diseases/infrastructure/diseases.api";
import { load, serverTransport } from "@/shared/api/server";
import { canManageContent } from "@/shared/auth/roles";

const { user, token } = Astro.locals;
const canManage = canManageContent(user);
const t = serverTransport(token);
const protocols = await load(() => createClinicalApi(t, "protocol").list());
const diseases = canManage ? await load(() => createDiseasesApi(t).list()) : null;
---

<BaseLayout title="Protocolos de Tratamiento">
  {
    protocols.error ? (
      <>
        <PageHeader title="Protocolos de Tratamiento" />
        <Alert>Error al cargar los protocolos: {protocols.error}</Alert>
      </>
    ) : (
      <ClinicalDocsPage
        client:load
        kind="protocol"
        initialItems={protocols.data ?? []}
        diseases={diseases?.data ?? []}
        canManage={canManage}
      />
    )
  }
</BaseLayout>
