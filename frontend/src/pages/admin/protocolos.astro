---
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Alert } from "@/components/ui/alert";
import { createClinicalApi } from "@/features/clinical/infrastructure/clinical.api";
import { ClinicalDocsPage } from "@/features/clinical/presentation/ClinicalDocsPage";
import { createDiseasesApi } from "@/features/diseases/infrastructure/diseases.api";
import { load, serverTransport } from "@/shared/api/server";

const t = serverTransport(Astro.locals.token);
const [docs, diseases] = await Promise.all([
  load(() => createClinicalApi(t, "protocol").list()),
  load(() => createDiseasesApi(t).list()),
]);
const error = docs.error ?? diseases.error;
---

<AdminLayout title="Protocolos de tratamiento">
  {
    error ? (
      <Alert>{error}</Alert>
    ) : (
      <ClinicalDocsPage client:load kind="protocol" initialItems={docs.data ?? []} diseases={diseases.data ?? []} canManage />
    )
  }
</AdminLayout>
